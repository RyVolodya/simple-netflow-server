# Used only when the users table is empty (first start).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=netflow
SESSION_HOURS=24

# v0.8.2 storage defaults
# Detailed 5-minute service-oriented conversations
RAW_RETENTION_HOURS=24
# Statistics retention in whole days; 30 days recommended for typical deployments
STATS_RETENTION_DAYS=30

# Active in-memory micro-batch cache
ACTIVE_CACHE_FLUSH_SECONDS=10
ACTIVE_CACHE_MAX_RECORDS=10000

# Collector spool protection
SPOOL_ROTATE_BYTES=134217728
SPOOL_HARD_LIMIT_MB=512
SPOOL_RESUME_MB=384

# Frontend host port
FRONTEND_PORT=8080

# Dashboard card snapshot cache. Prevents repeated COUNT(DISTINCT) scans.
DASHBOARD_SUMMARY_CACHE_SECONDS=30
